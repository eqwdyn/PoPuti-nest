{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack"
  },
  "projects": {
    "asd": {
      "type": "library",
      "root": "libs/asd",
      "entryFile": "index",
      "sourceRoot": "libs/asd/src",
      "compilerOptions": {
        "tsConfigPath": "libs/asd/tsconfig.lib.json"
      }
    }
  }
}